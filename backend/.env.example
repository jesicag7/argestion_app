PORT=3000
CORS_ORIGIN=*
# Reemplazar por el ID real del proyecto Firebase.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# No definir certificados activa el sandbox simulado local.
# Para homologación o producción, descomentar y configurar archivos PEM válidos.
# ARCA_CERT=./certificados/arca.crt
# ARCA_KEY=./certificados/arca.key
# ARCA_CUIT=20123456786
ARCA_KEY_PASSPHRASE=
ARCA_PRODUCTION=false
